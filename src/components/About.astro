---
import { profile, skills } from '../data/site';
---

<section class="section" id="about">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">About</h2>
      <span class="section__num mono"><b>02</b> / who am i</span>
    </div>

    <div class="about">
      <div class="about__text reveal">
        {profile.about.map((p) => <p>{p}</p>)}
        <dl class="about__meta mono">
          <dt>Name</dt><dd>{profile.name}（{profile.nameJa}）</dd>
          <dt>Based in</dt><dd>{profile.location}</dd>
          <dt>Tools</dt><dd>{skills.slice(0, 5).join(' / ')}</dd>
        </dl>
      </div>

      <aside class="note reveal" aria-label="最近のこと">
        <p class="note__title">Now ✎</p>
        <ul>
          <li>Astroで小さな実験サイトを量産中</li>
          <li>モーションの「ちょうどいい量」を研究中</li>
          <li>コーヒーは浅煎り派</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
