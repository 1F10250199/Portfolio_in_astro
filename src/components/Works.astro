---
import WorkCard from './WorkCard.astro';
import { works } from '../data/site';
---

<section class="section" id="works">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">Works</h2>
      <span class="section__num mono"><b>01</b> / {String(works.length).padStart(2, '0')} projects</span>
    </div>
    <div class="works-grid">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </div>
</section>
