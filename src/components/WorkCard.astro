---
import type { Work } from '../data/site';

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<a class="work-card reveal" href={`/works/${work.slug}/`} data-accent={work.accent}>
  <div class="work-card__thumb">
    {work.image ? (
      <img src={work.image} alt="" loading="lazy" />
    ) : (
      <span class="work-card__glyph" aria-hidden="true">{work.glyph}</span>
    )}
    <span class="work-card__year mono">{work.year}</span>
  </div>
  <div class="work-card__body">
    <h3 class="work-card__title">
      {work.title}
      <span class="work-card__arrow" aria-hidden="true">→</span>
    </h3>
    <p class="work-card__summary">{work.summary}</p>
    <ul class="tags">
      {work.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>
</a>
