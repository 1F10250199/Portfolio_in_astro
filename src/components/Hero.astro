---
import { profile } from '../data/site';
---

<section class="hero">
  <div class="hero__shapes" aria-hidden="true">
    <div class="shape shape--circle" data-depth="-28"></div>
    <div class="shape shape--square" data-depth="40"></div>
    <div class="shape shape--ring" data-depth="18"></div>
  </div>

  <div class="container">
    <p class="hero__hello mono"><span class="hero__wave">👋</span> Hello, I'm</p>
    <h1 class="hero__name">{profile.name}<span class="dot">.</span></h1>
    <p class="hero__role">
      <span class="typed" data-typed={JSON.stringify(profile.roles)}>{profile.roles[0]}</span><span class="caret" aria-hidden="true"></span>
    </p>
    <p class="hero__tagline">{profile.tagline}</p>
    <div class="hero__actions">
      <a class="btn btn--ghost" href="#contact">連絡する</a>
    </div>
  </div>
</section>
