---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="hero">
    <div class="hero__shapes" aria-hidden="true">
      <div class="shape shape--circle" data-depth="-40"></div>
      <div class="shape shape--square" data-depth="50"></div>
    </div>
    <div class="container">
      <p class="hero__hello mono">Error 404</p>
      <h1 class="hero__name">Oops<span class="dot">.</span></h1>
      <p class="hero__tagline">お探しのページは、どこかへ転がっていったみたいです。</p>
      <div class="hero__actions">
        <a class="btn" href="/">トップへ戻る <span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
